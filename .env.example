# Volunteering App Env File
# Generate all secrets with: uv run generate_keys.py

# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=your-db-password-here
POSTGRES_DB=volunteeringapp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_ECHO=False

# Argon2 (Hashing)
# Allowed values: RFC_9106_LOW_MEMORY, RFC_9106_HIGH_MEMORY
ARGON2_PROFILE=RFC_9106_LOW_MEMORY

# JWT Configuration
# JWT_SECRET_KEY: URL-safe Base64 string
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Encryption Key
# Must be exactly 64 hex characters (32 bytes)
ENCRYPTION_KEY=your-64-hex-encryption-key-here

# Cookie Configuration
COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Application Environment
ENVIRONMENT=development

# Logging Configuration
LOG_LEVEL=normal

# Demo Data
DEMO_DATA=true
